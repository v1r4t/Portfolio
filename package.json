{
  "name": "portfolio-downlink",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "predev": "node scripts/generate-posts.mjs",
    "prebuild": "node scripts/generate-posts.mjs",
    "preview:cf": "node scripts/patch-opennext-windows.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "node scripts/patch-opennext-windows.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify:shader": "node scripts/verify-shader.mjs",
    "verify:portrait": "node scripts/verify-portrait-shader.mjs",
    "verify:vgpu": "node scripts/verify-vgpu.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vgpu": "0.6.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@opennextjs/cloudflare": "^1.20.19",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vgpu/wgsl": "0.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "wrangler": "^4.168.0"
  }
}
